# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# The app validates configuration at startup (Joi) and refuses to boot if a
# required variable is missing or malformed. See docs/EDD.md #4 for the
# full reference and README.md#configuration for a summary.
#
# .env is never loaded in production (NODE_ENV=production) — inject real
# environment variables through your deployment platform instead.

# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (matches docker-compose.yml) ---
DATABASE_URL=postgresql://backend_starter:backend_starter@localhost:5432/backend_starter
# Schema targeted by generated queries (defaults to `public`).
DATABASE_SCHEMA=public

# --- Better Auth ---
# Generate a real secret with: openssl rand -base64 48
# Must be at least 32 characters.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-32-chars

# --- CORS (comma-separated allowlist of trusted web origins) ---
CORS_ORIGINS=http://localhost:3001

# --- Deployment topology ---
# Drives every session cookie attribute together, not as separate knobs.
# same-site  (default): Authenticated Client and API share a registrable
#            domain. Session cookie: SameSite=Lax, Secure in production.
# cross-site: Authenticated Client is deployed on a different site than the
#            API. Session cookie: SameSite=None; Secure; Partitioned (CHIPS).
#            Gives up the browser's own CSRF protection, so OriginGuard
#            validates the Origin header on state-changing starter routes.
DEPLOYMENT_TOPOLOGY=same-site

# --- Public base URL of this API (absolute http/https URL) ---
# Must be https when DEPLOYMENT_TOPOLOGY=cross-site or NODE_ENV=production.
PUBLIC_BASE_URL=http://localhost:3000

# --- Reverse proxy ---
# Number of proxies in front of this API. 0 if exposed directly.
# Decides the client IP used for rate limiting and logging.
TRUST_PROXY_HOPS=1

# --- Logging ---
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# --- Rate limits (values below are the built-in defaults) ---
# Starter-owned routes under /api/v1 (RateLimitGuard). Health probes exempt.
# Enforced PER PROCESS — see README.md#rate-limiting.
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL_SECONDS=60
# Native Better Auth routes under /api/auth. Counters live in PostgreSQL.
# Better Auth enables its limiter in production only.
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_TTL_SECONDS=3600
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_TTL_SECONDS=900

# --- Only required by the seed commands ---
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-now
# SEED_USER_EMAIL=user@example.com
# SEED_USER_PASSWORD=change-me-now