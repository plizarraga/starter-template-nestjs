# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# The app validates configuration at startup (Joi) and refuses to boot if a
# required variable is missing or malformed. See docs/EDD.md #10 for the
# full reference and README.md#configuration for a summary.
#
# .env is never loaded in production (NODE_ENV=production) — inject real
# environment variables through your deployment platform instead.

# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (matches docker-compose.yml) ---
DATABASE_URL=postgresql://backend_starter:backend_starter@localhost:5432/backend_starter

# --- Redis (matches docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Access tokens (JWT) ---
# Generate a real secret with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-32-chars-min
JWT_ISSUER=backend-starter
JWT_AUDIENCE=backend-starter-client
ACCESS_TOKEN_TTL_SECONDS=600

# --- Refresh sessions ---
# Generate a real secret with: openssl rand -base64 48
REFRESH_TOKEN_HMAC_SECRET=dev-only-refresh-secret-change-me-32-chars
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_NAME=refresh_token

# --- CORS (comma-separated allowlist of web origins) ---
CORS_ORIGINS=http://localhost:3001

# --- Logging ---
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# --- Password hashing (scrypt) — defaults are the secure baseline ---
# SCRYPT_N=131072
# SCRYPT_R=8
# SCRYPT_P=1
# SCRYPT_MAXMEM=268435456

# --- Rate limits — defaults shown, uncomment to override ---
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_TTL_SECONDS=3600
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_TTL_SECONDS=900
# RATE_LIMIT_REFRESH_MAX=30
# RATE_LIMIT_REFRESH_TTL_SECONDS=900

# --- Only required by `pnpm seed:admin` ---
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-now
